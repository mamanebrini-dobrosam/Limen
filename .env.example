# Baza (Replit PostgreSQL automatski postavlja DATABASE_URL)
DATABASE_URL=postgres://korisnik:lozinka@host:5432/limen

# Javna adresa aplikacije (koristi se u linkovima u emailu)
APP_URL=https://tvoja-aplikacija.replit.app
PORT=5000

# Email adrese koje dobijaju administratorska prava pri registraciji (zarezom odvojene)
ADMIN_EMAILS=tvoj@email.com

# SMTP za potvrdu emaila i reset lozinke (npr. Resend, SendGrid, Mailgun)
# Bez ovoga se emailovi ispisuju u log servera.
SMTP_URL=smtps://korisnik:lozinka@smtp.primjer.com:465
MAIL_FROM=LIMEN <no-reply@tvoja-domena.com>

# Gdje se čuvaju fotografije u razvoju i testovima (produkcija koristi Replit App Storage)
STORAGE_DIR=storage
MEDIA_STORAGE_BACKEND=local

# Pravilo od 30 sekundi (milisekunde) – ne mijenjati osim za testiranje
HOST_GRACE_MS=30000
GUEST_GRACE_MS=30000
# Poziv bez odgovora postaje "propušten poziv" nakon (ms)
INVITE_MISSED_AFTER_MS=120000

# Rate limiting – početne vrijednosti (broj zahtjeva u prozoru)
RATE_LIMITS_ENABLED=true
RL_LOGIN=5            # po 15 min, po nalogu i IP-u
RL_REGISTER=3         # po satu, po IP-u
RL_CONTACT_REQUEST=20 # po danu
RL_INVITE=30          # po satu
RL_MESSAGE=30         # po minuti
RL_UPLOAD=10          # po minuti
RL_REPORT=10          # po danu
